# API Keys
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Optional: Budget limits (in USD)
SOFT_BUDGET_LIMIT=1.00
HARD_BUDGET_LIMIT=5.00

# Optional: Verification depth limit
MAX_VERIFICATION_DEPTH=5

# Optional: Max disambiguation iterations
MAX_DISAMBIGUATION_ITERATIONS=10
